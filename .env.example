# Connection string for the platform database.
#
# OPTIONAL for now: if unset, the test harness falls back to an embedded
# in-memory PGlite database so tests run with zero external setup.
#
# When you have a real Postgres, set this to switch the harness (and production)
# onto it. For tests it MUST point at a dedicated test database — the harness
# truncates its public schema between tests.
# DATABASE_URL=postgres://user:password@localhost:5432/najia_test
